/*
 * Ashen tamper/heartbeat MCU link on the UNO Q's QRB2210<->STM32U585 UART.
 */

/dts-v1/;
/plugin/;

&tlmm {
	/*
	 * GPIO_37 drives the MCU's BOOT0 through a TXS0104 level shifter, whose
	 * pull-ups win when the pin is undriven. Hold it low so every MCU reset
	 * (tamper self-reset, SWD flashing) boots ashen-fw from flash instead of
	 * the STM32 ROM bootloader.
	 */
	mcu-boot0-hog {
		gpio-hog;
		gpios = <37 0>;
		output-low;
		line-name = "MCU_BOOT0";
	};
};

/*
 * The demo only needs the display (KMS) for the console; the Adreno GPU fails
 * to initialise (-EINVAL) and its retries put errors on the console.
 */
&gpu {
	status = "disabled";
};

/*
 * No audio or video codec in the demo. The ADSP firmware fails to load, so the
 * LPASS audio blocks only defer forever and print warnings onto the console;
 * venus fails on its firmware too (QHEE did its PIL memory assignment as well).
 */
&venus { status = "disabled"; };

/*
 * Linux runs at EL2 here (QHEE is torn down for KVM), so nothing does QHEE's PIL
 * work anymore (SHM bridges, mapping the carveout for the subsystem's SMMU
 * stream): the ADSP's PAS INIT_IMAGE then fails with -EINVAL. With the ADSP's
 * firmware stream ID given, qcom_q6v5_pas does that work itself, as in the
 * upstream *-el2.dtso overlays. 0x1c0 is the base of agatti's LPASS SID block
 * (q6asm uses 0x1c1, the fastrpc compute banks 0x1c3 and up).
 * QHEE also clocks and starts the Q6 after TrustZone's auth_and_reset, and halts it
 * after shutdown; qcom_q6v5_pas does that when given these registers.
 */
&remoteproc_adsp {
	reg = <0x0 0x0ab00000 0x0 0x100>,
	      <0x0 0x0a400000 0x0 0x1000>,
	      <0x0 0x0a780000 0x0 0x20000>,
	      <0x0 0x0a540000 0x0 0x1000>,
	      <0x0 0x0a950000 0x0 0x10000>,
	      <0x0 0x0ac02000 0x0 0x1000>,
	      <0x0 0x00362000 0x0 0x10>,
	      <0x0 0x0143a000 0x0 0x10>,
	      <0x0 0x014c0000 0x0 0x4>;
	reg-names = "base", "qdsp6ss", "lpass-cc", "lpass-cfg", "lpass-csr", "lpass-tbu",
		    "halt", "gcc", "gcc-bcr";
	iommus = <&apps_smmu 0x1c0 0x0>;
	/*
	 * What QHEE's stage 2 gave the ADSP Q6 (SID 0x1c0, VMID 6) besides its firmware,
	 * dumped from the SMMU it left behind: <iova pa size prot>, prot bits:
	 * 1 read, 2 write, 4 device memory, 8 cacheable.
	 */
	qcom,iommu-static-map =
		<0x00340000 0x00340000 0x00040000 0x7>,
		<0x003c0000 0x003c0000 0x0000b000 0x5>,
		<0x003cb000 0x003cb000 0x00001000 0x7>,
		<0x003cc000 0x003cc000 0x0001d000 0x5>,
		<0x003e9000 0x003e9000 0x00001000 0x7>,
		<0x003ea000 0x003ea000 0x00006000 0x5>,
		<0x003f1000 0x003f1000 0x00001000 0x7>,
		<0x00400000 0x00400000 0x00800000 0x7>,
		<0x01400000 0x01400000 0x00012000 0x5>,
		<0x01413000 0x01413000 0x00004000 0x5>,
		<0x01417000 0x01417000 0x00002000 0x7>,
		<0x01419000 0x01419000 0x00006000 0x5>,
		<0x0141f000 0x0141f000 0x00001000 0x7>,
		<0x01420000 0x01420000 0x00001000 0x5>,
		<0x01421000 0x01421000 0x00001000 0x7>,
		<0x01422000 0x01422000 0x00006000 0x5>,
		<0x01428000 0x01428000 0x00001000 0x7>,
		<0x01429000 0x01429000 0x00007000 0x5>,
		<0x01430000 0x01430000 0x00010000 0x7>,
		<0x01440000 0x01440000 0x00003000 0x5>,
		<0x01443000 0x01443000 0x00001000 0x7>,
		<0x01444000 0x01444000 0x00003000 0x5>,
		<0x01447000 0x01447000 0x00001000 0x7>,
		<0x01448000 0x01448000 0x0000c000 0x5>,
		<0x01454000 0x01454000 0x00002000 0x7>,
		<0x01456000 0x01456000 0x0000c000 0x5>,
		<0x01462000 0x01462000 0x00001000 0x7>,
		<0x01463000 0x01463000 0x00012000 0x5>,
		<0x01475000 0x01475000 0x00001000 0x7>,
		<0x01476000 0x01476000 0x0017a000 0x5>,
		<0x018a3000 0x018a3000 0x00001000 0x7>,
		<0x018a8000 0x018a8000 0x00001000 0x7>,
		<0x01b04000 0x01b04000 0x00001000 0x5>,
		<0x01b05000 0x01b05000 0x00001000 0x7>,
		<0x01b08000 0x01b08000 0x00001000 0x7>,
		<0x01b21000 0x01b12000 0x00002000 0x7>,
		<0x01b3a000 0x01b3a000 0x00001000 0x7>,
		<0x01b3d000 0x01b3d000 0x00001000 0x7>,
		<0x01b40000 0x01b40000 0x00007000 0x5>,
		<0x01c00000 0x01c00000 0x00030000 0x7>,
		<0x01c40000 0x01c40000 0x00010000 0x7>,
		<0x01c60000 0x01c60000 0x00081000 0x5>,
		<0x03e00000 0x03e00000 0x00100000 0x7>,
		<0x03f00000 0x03f00000 0x000a0000 0x5>,
		<0x04400000 0x04400000 0x0000b000 0x5>,
		<0x0440b000 0x0440b000 0x00001000 0x7>,
		<0x0440c000 0x0440c000 0x00034000 0x5>,
		<0x04450000 0x04450000 0x00001000 0x5>,
		<0x04455000 0x04455000 0x00001000 0x5>,
		<0x0445a000 0x0445a000 0x00001000 0x5>,
		<0x0450e000 0x0450e000 0x00001000 0x7>,
		<0x045f2000 0x045f2000 0x00001000 0x7>,
		<0x045f6000 0x045f6000 0x00001000 0x5>,
		<0x04a2c000 0x04a2c000 0x00008000 0x7>,
		<0x04e00000 0x04e00000 0x0000d000 0x7>,
		<0x05e00000 0x05e00000 0x000c0000 0x7>,
		<0x08001000 0x08001000 0x00002000 0x7>,
		<0x08005000 0x08005000 0x00001000 0x7>,
		<0x08041000 0x08041000 0x00002000 0x7>,
		<0x08045000 0x08045000 0x00002000 0x7>,
		<0x08048000 0x08048000 0x00001000 0x7>,
		<0x08a20000 0x08a20000 0x00020000 0x7>,
		<0x0ab04000 0x0ab04000 0x00009000 0x7>,
		<0x0ab0f000 0x0ab0f000 0x00045000 0x7>,
		<0x0ab84000 0x0ab84000 0x00003000 0x7>,
		<0x0abc0000 0x0abc0000 0x00002000 0x7>,
		<0x0e000000 0x0e000000 0x01000000 0x6>,
		<0x46000000 0x46000000 0x0014f000 0xb>,
		<0x461cd000 0x461cd000 0x00032000 0xb>,
		<0x461ff000 0x461ff000 0x00001000 0x9>;
};
&pmic4125_codec { status = "disabled"; };
&sound { status = "disabled"; };
&lpass_tlmm { status = "disabled"; };
&rxmacro { status = "disabled"; };
&txmacro { status = "disabled"; };
&vamacro { status = "disabled"; };
&swr0 { status = "disabled"; };
&swr1 { status = "disabled"; };

&uart2 {
	status = "okay";

	tamper: tamper {
		compatible = "ashen,hbv1";
		timeout-us = <100000>;
		refresh-ivl-us = <50000>;
		/* armed from userspace once paired, see demo/ashen-pair */
		no-autostart;
	};
};

/*
 * The USB-C port only ever sinks power and the demo dock (a self-powered
 * hub with Ethernet) never attaches, so the anx7625 leaves dwc3 in device
 * mode. Run it host-only; build.sh also drops usb-role-switch, which an
 * overlay cannot delete, or anx7625 would defer waiting for the switch.
 */
&usb_dwc3 {
	dr_mode = "host";
};
